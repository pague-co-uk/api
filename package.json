    "test:cov": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.ts --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk ./node_modules/jest/bin/jest.js --config jest.config.ts --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
